#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
dc() { docker compose -f compose.yaml -f compose.dev.yaml "$@"; }
case "${1:-help}" in
  init)
    if [ ! -f .env ]; then
      cp .env.example .env
      docker run --rm -v "$PWD:/app" -w /app php:8.5.10-fpm-bookworm@sha256:81b9c405b013ebda0c9b8cd7a1a61424cf3627ca96348d93752a9b0539ce9a25 php bin/init-env.php
    fi
    dc build app
    dc up -d db
    dc run --rm app composer install --no-interaction
    dc run --rm app php artisan migrate --force
    dc run --rm app php artisan db:seed --force
    docker run --rm -v "$PWD:/app" -w /app node:24-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 sh -c 'npm ci --ignore-scripts && npm run build'
    dc run --rm app php artisan filament:assets
    dc up -d --no-build app worker web
    ;;
  up) dc up -d --no-build db app worker web ;;
  down) dc down ;;
  artisan) shift; dc run --rm app php artisan "$@" ;;
  composer) shift; dc run --rm app composer "$@" ;;
  check)
    dc exec -T db sh -c 'psql -U "$POSTGRES_USER" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '\''company_ai_test'\''" | grep -q 1 || createdb -U "$POSTGRES_USER" company_ai_test'
    dc run --rm app vendor/bin/pint --test
    dc run --rm app sh bin/analyse
    dc run --rm app vendor/bin/phpunit
    dc run --rm app composer audit
    ;;
  *) echo 'Usage: bin/dev init|up|down|artisan ...|composer ...|check'; exit 1 ;;
esac
