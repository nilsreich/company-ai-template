APP_NAME="Dokumentenprüfung"
APP_ENV=local
# Feedback is available to authenticated users in local development only.
# Set APP_BUILD to the current Git commit when starting a new build.
APP_BUILD=unknown
APP_PLAN=prototype
# Use a private repository and a fine-grained token with Issues: read/write.
FEEDBACK_GITHUB_REPOSITORY=
FEEDBACK_GITHUB_TOKEN=
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=company_ai
DB_USERNAME=company_ai
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
CACHE_STORE=database
FILESYSTEM_DISK=private
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DEV_LOGIN_ENABLED=false
DOCUMENT_MAX_KIB=256
AI_DRIVER=fake
AI_FAKE_SCENARIO=success
AI_FAKE_DELAY=8
AI_API_KEY=
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_TIMEOUT=30
AI_URL=https://api.openai.com/v1/responses
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/auth/entra/callback
TRUSTED_PROXIES=
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
TELESCOPE_ENABLED=false
